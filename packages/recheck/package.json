{
  "name": "@redocly/recheck",
  "version": "2.51.0",
  "description": "Markdown and prose linting engine for Redocly CLI",
  "type": "module",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0 || >=20.19.0 <21.0.0",
    "npm": ">=10"
  },
  "engineStrict": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Redocly/redocly-cli.git"
  },
  "homepage": "https://github.com/Redocly/redocly-cli",
  "keywords": [
    "Markdown",
    "Markdoc",
    "lint",
    "prose",
    "documentation"
  ],
  "contributors": [
    "Adam Altman <adam@redocly.com> (https://redocly.com/)"
  ],
  "dependencies": {
    "@redocly/ajv": "^8.18.3",
    "ajv-formats": "^3.0.1",
    "colorette": "^2.0.20",
    "js-yaml": "^4.3.1",
    "micromark": "^4.0.2",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-symbol": "^2.0.0",
    "picomatch": "^4.0.4",
    "string-width": "^8.2.1"
  },
  "peerDependencies": {
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5"
  },
  "peerDependenciesMeta": {
    "dictionary-en": {
      "optional": true
    },
    "nspell": {
      "optional": true
    }
  },
  "devDependencies": {
    "@markdoc/markdoc": "^0.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^2.3.4",
    "dictionary-en": "^4.0.0",
    "micromark-util-types": "^2.0.2",
    "nspell": "^2.1.5",
    "typescript": "6.0.2"
  },
  "files": [
    "lib",
    "presets",
    "examples"
  ]
}
