}</pre>
    </details>

    <details class="change minor">
      <summary>
        <span class="badge">minor</span>
        <code>added</code>
        <code class="loc">#/components</code>
        
      </summary>
      <pre>{
  &quot;revision&quot;: {
    &quot;file&quot;: &quot;revision.yaml&quot;,
    &quot;pointer&quot;: &quot;#/components&quot;,
    &quot;line&quot;: 26,
    &quot;col&quot;: 3,
    &quot;value&quot;: {
