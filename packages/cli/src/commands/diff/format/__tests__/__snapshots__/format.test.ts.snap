exports[`htmlDiff > should render a self-contained page 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>API diff</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, sans-serif; margin: 2rem auto; max-width: 60rem; padding: 0 1rem; color: #1f2933; }
  h1 { font-size: 1.4rem; }
  .summary span { margin-right: 1rem; font-weight: 600; }
  .change { border: 1px solid #e0e4e8; border-radius: 6px; margin: .5rem 0; padding: .25rem .75rem; }
  .change summary { cursor: pointer; display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
  .badge { border-radius: 4px; padding: 0 .5rem; font-size: .8rem; color: #fff; }
  .major .badge { background: #c0392b; }
  .minor .badge { background: #1e8449; }
  .patch .badge { background: #9aa5b1; }
  .msg { color: #52606d; }
  .rules { color: #9aa5b1; font-size: .85rem; }
  pre { background: #f5f7fa; padding: .75rem; border-radius: 6px; overflow-x: auto; }
  code.loc { word-break: break-all; }
</style>
</head>
<body>
<h1>API diff: base.yaml → revision.yaml</h1>
<p class="summary">
  <span style="color:#c0392b">4 major</span>
  <span style="color:#1e8449">1 minor</span>
  <span style="color:#9aa5b1">1 patch</span>
  <span style="color:#9aa5b1">requires a major bump</span>
  <span style="color:#9aa5b1">OpenAPI 3.1</span>
</p>

    <details class="change patch">
      <summary>
        <span class="badge">patch</span>
        <code>modified</code>
        <code class="loc">#/paths/~1menu/get · summary</code>
        
      </summary>
      <pre>{
  &quot;base&quot;: {
    &quot;file&quot;: &quot;base.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1menu/get/summary&quot;,
    &quot;line&quot;: 6,
    &quot;col&quot;: 16,
    &quot;value&quot;: &quot;List the menu&quot;
  },
  &quot;revision&quot;: {
    &quot;file&quot;: &quot;revision.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1menu/get/summary&quot;,
    &quot;line&quot;: 6,
    &quot;col&quot;: 16,
    &quot;value&quot;: &quot;List the whole menu&quot;
  }
}</pre>
    </details>

    <details class="change major">
      <summary>
        <span class="badge">major</span>
        <code>modified</code>
        <code class="loc">#/paths/~1menu/get/parameters/{query:limit} · required</code>
        <span class="msg">\`limit\` query parameter became required.</span> <span class="rules">parameter-became-required</span>
      </summary>
      <pre>{
  &quot;base&quot;: {
    &quot;file&quot;: &quot;base.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1menu/get/parameters/0&quot;,
    &quot;line&quot;: 8,
    &quot;col&quot;: 11
  },
  &quot;revision&quot;: {
    &quot;file&quot;: &quot;revision.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1menu/get/parameters/0/required&quot;,
    &quot;line&quot;: 8,
    &quot;col&quot;: 47,
    &quot;value&quot;: true
  }
}</pre>
    </details>

    <details class="change major">
      <summary>
        <span class="badge">major</span>
        <code>modified</code>
        <code class="loc">#/paths/~1orders/post/requestBody/content/application~1json/schema/properties/note · pattern</code>
        <span class="msg">\`pattern\` of \`note\` changed from 'a' to 'a|b'.</span> <span class="rules">string-constraint-changed</span>
      </summary>
      <pre>{
  &quot;base&quot;: {
    &quot;file&quot;: &quot;base.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1orders/post/requestBody/content/application~1json/schema/properties/note/pattern&quot;,
    &quot;line&quot;: 15,
    &quot;col&quot;: 68,
    &quot;value&quot;: &quot;a&quot;
  },
  &quot;revision&quot;: {
    &quot;file&quot;: &quot;revision.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1orders/post/requestBody/content/application~1json/schema/properties/note/pattern&quot;,
    &quot;line&quot;: 15,
    &quot;col&quot;: 68,
    &quot;value&quot;: &quot;a|b&quot;
  }
}</pre>
    </details>

    <details class="change major">
      <summary>
        <span class="badge">major</span>
        <code>removed</code>
        <code class="loc">#/paths/~1orders/delete</code>
        <span class="msg">Operation \`DELETE /orders\` was removed.</span> <span class="rules">operation-removed</span>
      </summary>
      <pre>{
  &quot;base&quot;: {
    &quot;file&quot;: &quot;base.yaml&quot;,
    &quot;pointer&quot;: &quot;#/paths/~1orders/delete&quot;,
    &quot;line&quot;: 18,
    &quot;col&quot;: 7,
    &quot;value&quot;: {
      &quot;summary&quot;: &quot;&lt;script&gt;alert(1)&lt;/script&gt;&quot;,
      &quot;responses&quot;: {
        &quot;204&quot;: {
          &quot;description&quot;: &quot;Cancelled&quot;
        }
      }
    }
  }
}</pre>
    </details>

    <details class="change major">
      <summary>
        <span class="badge">major</span>
        <code>removed</code>
        <code class="loc">#/webhooks/orderReady/post/requestBody/content/application~1json/schema/properties/eta</code>
        <span class="msg">Property \`eta\` was removed.</span> <span class="rules">property-removed</span>
      </summary>
      <pre>{
  &quot;base&quot;: {
    &quot;file&quot;: &quot;base.yaml&quot;,
    &quot;pointer&quot;: &quot;#/webhooks/orderReady/post/requestBody/content/application~1json/schema/properties/eta&quot;,
    &quot;line&quot;: 26,
    &quot;col&quot;: 42,
