exports[`markdownDiff > should render one table row per change 1`] = `
"## API diff: base.yaml → revision.yaml

**4** major · **1** minor · **1** patch · requires a **major** bump

| Impact | Change | Pointer | Location | Details |
| --- | --- | --- | --- | --- |
| ⚪ patch | modified | \`#/paths/~1menu/get · summary\` | revision.yaml:6:16 |  |
| 🔴 major | modified | \`#/paths/~1menu/get/parameters/{query:limit} · required\` | revision.yaml:8:47 | \\\`limit\\\` query parameter became required. \`parameter-became-required\` |
| 🔴 major | modified | \`#/paths/~1orders/post/requestBody/content/application~1json/schema/properties/note · pattern\` | revision.yaml:15:68 | \\\`pattern\\\` of \\\`note\\\` changed from 'a' to 'a\\|b'. \`string-constraint-changed\` |
| 🔴 major | removed | \`#/paths/~1orders/delete\` | base.yaml:18:7 | Operation \\\`DELETE /orders\\\` was removed. \`operation-removed\` |
| 🔴 major | removed | \`#/webhooks/orderReady/post/requestBody/content/application~1json/schema/properties/eta\` | base.yaml:26:42 | Property \\\`eta\\\` was removed. \`property-removed\` |
| 🟢 minor | added | \`#/components\` | revision.yaml:26:3 |  |"
`;

exports[`nextVersionDiff > should bump the base version as far as the changes require 1`] = `"2.0.0"`;

