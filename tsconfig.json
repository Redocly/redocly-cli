{
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "nodenext",
    "target": "es2023",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "resolveJsonModule": true,
    "strict": false,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "lib": ["ESNext", "DOM", "dom.iterable"],
    "paths": {
      "*": ["./packages/*"],
      "@redocly/recheck": ["./packages/recheck/src/index.ts"],
      "@redocly/recheck/config": ["./packages/recheck/src/config/public.ts"]
    },
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true
  },
  "exclude": ["tests/e2e/generate-client/examples", "tests/e2e/generate-client/*-consumer"]
}
