{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // System toolchains the generator tests shell out to.
  "ignoreBinaries": ["go", "gofmt", "php"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{js,mjs}", "plugins/*.js", "tests/**/*.{ts,js,mjs,cjs}"],
      "ignore": [
        // Example material for users (cookbook plugins, sample descriptions, configs and
        // plugins); not part of the build and its dependencies are not installed here.
        "cookbook/**",
        "resources/**",
        // The consumers import a client that the e2e run generates in a temp folder,
        // so their imports do not resolve in a clean checkout. Same exclusion as the root tsconfig.
        "tests/e2e/generate-client/*/consumer*/**",
      ],
      // Only referenced from generated e2e consumer code and the client generator examples.
      "ignoreDependencies": ["@faker-js/faker", "swr", "valibot"],
    },
    // Package entry points come from each package.json; fixtures are loaded by path in tests.
    "packages/cli": {
      "entry": ["scripts/*.mjs", "src/**/__tests__/fixtures/**"],
    },
    "packages/core": {
      "entry": ["src/**/__tests__/fixtures/**"],
    },
    "packages/client-generator": {
      "entry": [
        // Runtime templates are copied into generated clients; their exports are the client's API.
        "src/generators/*/runtime/**/*.ts",
        "src/**/__tests__/fixtures/**",
        "scripts/*.mjs",
        "tests/**/*.ts",
      ],
      // The examples gitignore their generated clients, and the test consumers import a client
      // that the test run generates in a temp folder, so their imports do not resolve in a clean
      // checkout. Same exclusions as the root tsconfig.
      "ignore": ["examples/**", "tests/**/consumer*/**"],
    },
  },
}
